# ==============================================================================
# by-lite Portable Runtime Builder (Ubuntu 24.04 LTS / glibc 2.39)
# ==============================================================================
# Compiles WPE WebKit 2.0 (LTS), libwpe, WPEBackend-fdo, and by-lite in an
# isolated, hermetic sysroot compatible with Ubuntu 24.04, Zorin OS 18,
# Linux Mint 22, Debian, Fedora, and Arch Linux.
# ==============================================================================

FROM docker.io/library/ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# Enable universe and install build tools
RUN sed -i 's/Components: main/Components: main universe/' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        meson \
        pkg-config \
        git \
        curl \
        ca-certificates \
        tar \
        xz-utils \
        python3 \
        ruby \
        bison \
        flex \
        gperf \
        libglib2.0-dev \
        libsoup-3.0-dev \
        libwayland-dev \
        wayland-protocols \
        libepoxy-dev \
        libegl1-mesa-dev \
        libgbm-dev \
        libdrm-dev \
        libgstreamer1.0-dev \
        libgstreamer-plugins-base1.0-dev \
        libgstreamer-gl1.0-0 \
        libharfbuzz-dev \
        libicu-dev \
        libjpeg-dev \
        libpng-dev \
        libwebp-dev \
        libxml2-dev \
        libxslt1-dev \
        libsqlite3-dev \
        libxkbcommon-dev \
        libseccomp-dev \
        libtasn1-6-dev \
        libhyphen-dev \
        libfontconfig1-dev \
        libfreetype6-dev \
        shared-mime-info \
        desktop-file-utils \
    && rm -rf /var/lib/apt/lists/*

# Install Rust toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

# Isolated build prefix
ENV PREFIX="/opt/by-lite-runtime"
ENV PKG_CONFIG_PATH="${PREFIX}/lib/x86_64-linux-gnu/pkgconfig:${PREFIX}/lib/pkgconfig:${PKG_CONFIG_PATH}"
ENV LD_LIBRARY_PATH="${PREFIX}/lib/x86_64-linux-gnu:${PREFIX}/lib:${LD_LIBRARY_PATH}"

# 1. Build and install libwpe
WORKDIR /build
RUN curl -fsSL https://wpewebkit.org/releases/libwpe-1.16.3.tar.xz | tar -xJ && \
    cd libwpe-1.16.3 && \
    meson setup build --prefix="${PREFIX}" --buildtype=release && \
    ninja -C build install

# 2. Build and install WPEBackend-fdo
RUN curl -fsSL https://wpewebkit.org/releases/wpebackend-fdo-1.14.3.tar.xz | tar -xJ && \
    cd wpebackend-fdo-1.14.3 && \
    meson setup build --prefix="${PREFIX}" --buildtype=release && \
    ninja -C build install

# 3. Build and install WPE WebKit 2.46 (LTS)
RUN curl -fsSL https://wpewebkit.org/releases/wpewebkit-2.46.5.tar.xz | tar -xJ && \
    cd wpewebkit-2.46.5 && \
    cmake -B build -G Ninja \
        -DPORT=WPE \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="${PREFIX}" \
        -DUSE_SOUP2=OFF \
        -DENABLE_MINIBROWSER=OFF \
        -DENABLE_DOCUMENTATION=OFF \
        -DENABLE_INTROSPECTION=OFF \
        -DENABLE_WEB_AUDIO=ON \
        -DENABLE_VIDEO=ON \
        -DENABLE_MEDIA_SOURCE=ON \
        -DENABLE_ENCRYPTED_MEDIA=ON \
        -DENABLE_TOUCH_EVENTS=ON && \
    ninja -C build install

# 4. Build by-lite with RPATH pointing to bundled ../lib
WORKDIR /src
COPY . .
RUN RUSTFLAGS="-C link-args=-Wl,-rpath,\$ORIGIN/../lib" \
    cargo build --release -p by-lite-cli

# 5. Assemble portable distribution bundle
WORKDIR /dist
RUN mkdir -p by-lite-portable/bin by-lite-portable/lib by-lite-portable/libexec && \
    cp /src/target/release/by-lite by-lite-portable/bin/by-lite-bin && \
    cp -d ${PREFIX}/lib/libWPEWebKit* by-lite-portable/lib/ 2>/dev/null || cp -d ${PREFIX}/lib/x86_64-linux-gnu/libWPEWebKit* by-lite-portable/lib/ && \
    cp -d ${PREFIX}/lib/libwpe* by-lite-portable/lib/ 2>/dev/null || cp -d ${PREFIX}/lib/x86_64-linux-gnu/libwpe* by-lite-portable/lib/ && \
    cp -d ${PREFIX}/lib/libWPEBackend* by-lite-portable/lib/ 2>/dev/null || cp -d ${PREFIX}/lib/x86_64-linux-gnu/libWPEBackend* by-lite-portable/lib/ && \
    cp -r ${PREFIX}/libexec/* by-lite-portable/libexec/

# Universal launcher wrapper script
RUN echo '#!/usr/bin/env bash' > by-lite-portable/by-lite && \
    echo 'set -e' >> by-lite-portable/by-lite && \
    echo 'SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"' >> by-lite-portable/by-lite && \
    echo 'export LD_LIBRARY_PATH="$SELF_DIR/lib:$SELF_DIR/../lib:${LD_LIBRARY_PATH:-}"' >> by-lite-portable/by-lite && \
    echo 'export WEBKIT_EXEC_PATH="$SELF_DIR/libexec/wpe-webkit-2.0"' >> by-lite-portable/by-lite && \
    echo 'export WPE_BACKEND_LIBRARY="$SELF_DIR/lib/libWPEBackend-fdo-1.0.so"' >> by-lite-portable/by-lite && \
    echo 'exec "$SELF_DIR/bin/by-lite-bin" "$@"' >> by-lite-portable/by-lite && \
    chmod +x by-lite-portable/by-lite

# One-step local install script
RUN echo '#!/usr/bin/env bash' > by-lite-portable/install.sh && \
    echo 'set -e' >> by-lite-portable/install.sh && \
    echo 'echo "[by-lite] Instalando runtime portatil com WPE WebKit 2.0 embutido..."' >> by-lite-portable/install.sh && \
    echo 'INSTALL_DIR="$HOME/.local/share/by-lite"' >> by-lite-portable/install.sh && \
    echo 'BIN_DIR="$HOME/.local/bin"' >> by-lite-portable/install.sh && \
    echo 'mkdir -p "$INSTALL_DIR" "$BIN_DIR"' >> by-lite-portable/install.sh && \
    echo 'cp -r bin lib libexec by-lite "$INSTALL_DIR/"' >> by-lite-portable/install.sh && \
    echo 'ln -sf "$INSTALL_DIR/by-lite" "$BIN_DIR/by-lite"' >> by-lite-portable/install.sh && \
    echo '"$BIN_DIR/by-lite" install-mime' >> by-lite-portable/install.sh && \
    echo 'echo "[by-lite] Runtime portatil instalado com sucesso em $BIN_DIR/by-lite!"' >> by-lite-portable/install.sh && \
    chmod +x by-lite-portable/install.sh

# Compress final distribution archive
RUN tar -czf by-lite-portable-linux-x86_64.tar.gz by-lite-portable
